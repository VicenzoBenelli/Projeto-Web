{
  "name": "@petshop/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@petshop/shared": "1.0.0", "@prisma/client": "6.19.0",
    "bcrypt": "^6.0.0", "cors": "^2.8.5", "dotenv": "^16.6.0",
    "express": "^5.1.0", "jsonwebtoken": "^9.0.2", "swagger-ui-express": "^5.0.1",
    "swagger-jsdoc": "^6.2.8", "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0", "@types/cors": "^2.8.19", "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10", "@types/node": "^22.18.0",
    "@types/swagger-jsdoc": "^6.0.4", "@types/swagger-ui-express": "^4.1.8",
    "prisma": "6.19.0", "tsx": "^4.20.0", "typescript": "^5.9.0"
  },
  "prisma": {"seed": "tsx prisma/seed.ts"}
}
